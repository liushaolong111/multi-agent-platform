# ===== LLM =====
DEEPSEEK_API_KEY=sk-你的真实key
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
# LLM_TEMPERATURE=0
# LLM_MAX_RETRIES=3

# ===== Redis（短期记忆）=====
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_DB=0
# SESSION_TTL=3600

# ===== 长期记忆 =====
# 支持 PostgreSQL 或 SQLite，填 SQLAlchemy 连接串即可；数据库不可达时自动跳过长期记忆
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent123
POSTGRES_DB=agent_db
# DATABASE_URL=postgresql+psycopg2://agent:agent123@localhost:5432/agent_db
# 或 MySQL：DATABASE_URL=mysql+pymysql://root:密码@localhost:3306/agent_db?charset=utf8mb4
DATABASE_URL=sqlite:///./data/long_term_memory.db

# ===== RAG =====
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# RAG_TOP_K=3

# ===== 工作流 =====
# MAX_ITERATIONS=3
# ReAct 工具循环最大轮数（防模型无限调工具）
# MAX_TOOL_ROUNDS=3
# 人工审批：true 时高风险工具（业务库查询）执行前需 POST /chat/approve 确认
# APPROVAL_MODE=false

# ===== 业务数据库（Text-to-SQL 查询目标）=====
# 默认 SQLite 零依赖；生产切 PostgreSQL / MySQL：
# BUSINESS_DATABASE_URL=postgresql+psycopg2://agent:agent123@localhost:5432/agent_db
# BUSINESS_DATABASE_URL=mysql+pymysql://root:密码@localhost:3306/business_db?charset=utf8mb4

# ===== MCP 工具总线 =====
# true 时 Agent 工具列表追加 MCP Server 暴露的工具（mysql/vector/erp）
# 独立运行 MCP Server：python -m app.mcp.server
# ENABLE_MCP_TOOLS=false

# ===== 用户认证与 RBAC =====
# true 时 /chat 需要 JWT（先 POST /auth/login 获取）；false 保持免登录（本地开发/CI 友好）
# AUTH_ENABLED=false
# JWT_SECRET=dev-secret-key-32bytes-change-in-prod!
# JWT_EXPIRE_MINUTES=120

# ===== 向量存储 =====
# faiss（默认，本地嵌入式）| qdrant（服务化，原生 metadata 过滤；不可达自动降级 faiss）
# VECTOR_STORE=faiss
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=knowledge_base

# ===== 日志 =====
# json：每行一个 JSON 对象（生产/容器采集）；console：彩色可读输出（默认）
# LOG_FORMAT=console
# LOG_LEVEL=INFO

# ===== 可观测性：LangSmith 链路追踪（可选）=====
# 注册 https://smith.langchain.com 获取 API Key 后取消注释，
# 即可在 LangSmith 控制台查看每个节点的完整调用链与 token 消耗
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_你的key
# LANGSMITH_PROJECT=multi-agent-platform

# ===== API 安全 =====
# 设置后 /chat 与 /chat/stream 需要请求头 X-API-Key；留空则不鉴权
# API_KEY=
# 单 IP 每分钟最大请求数
# RATE_LIMIT_PER_MINUTE=10

# ===== CORS（生产环境建议指定具体域名，逗号分隔）=====
# CORS_ORIGINS=*
