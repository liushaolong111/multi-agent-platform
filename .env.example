# ===== LLM =====
DEEPSEEK_API_KEY=sk-你的真实key
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
# LLM_TEMPERATURE=0
# LLM_MAX_RETRIES=3

# ===== Redis（短期记忆）=====
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_DB=0
# SESSION_TTL=3600

# ===== 长期记忆 =====
# 支持 PostgreSQL 或 SQLite，填 SQLAlchemy 连接串即可；数据库不可达时自动跳过长期记忆
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent123
POSTGRES_DB=agent_db
# DATABASE_URL=postgresql+psycopg2://agent:agent123@localhost:5432/agent_db
DATABASE_URL=sqlite:///./data/long_term_memory.db

# ===== RAG =====
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# RAG_TOP_K=3

# ===== 工作流 =====
# MAX_ITERATIONS=3

# ===== 可观测性：LangSmith 链路追踪（可选）=====
# 注册 https://smith.langchain.com 获取 API Key 后取消注释，
# 即可在 LangSmith 控制台查看每个节点的完整调用链与 token 消耗
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_你的key
# LANGSMITH_PROJECT=multi-agent-platform

# ===== API 安全 =====
# 设置后 /chat 与 /chat/stream 需要请求头 X-API-Key；留空则不鉴权
# API_KEY=
# 单 IP 每分钟最大请求数
# RATE_LIMIT_PER_MINUTE=10

# ===== CORS（生产环境建议指定具体域名，逗号分隔）=====
# CORS_ORIGINS=*
